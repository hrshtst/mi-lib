# Prefer in-tree headers of the mi-lib workspace over the installed
# copies in ~/usr/include, so cross-library navigation lands in the
# source trees. The installed prefix is re-appended as a fallback
# (e.g. for generated *_export.h after a `make clean`).
CompileFlags:
  Remove: [-I/home/atsuta/usr/include]
  Add:
    - -I/home/atsuta/mi-lib/zeda/include
    - -I/home/atsuta/mi-lib/zm/include
    - -I/home/atsuta/mi-lib/neuz/include
    - -I/home/atsuta/mi-lib/dzco/include
    - -I/home/atsuta/mi-lib/zeo/include
    - -I/home/atsuta/mi-lib/roki/include
    - -I/home/atsuta/mi-lib/liw/include
    - -I/home/atsuta/mi-lib/zx11/include
    - -I/home/atsuta/mi-lib/roki-gl/include
    - -I/home/atsuta/mi-lib/roki-fd/include
    - -I/home/atsuta/mi-lib/pedi2/include
    - -I/home/atsuta/usr/include
