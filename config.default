# shellcheck shell=bash
# shellcheck disable=SC2034  # variables are consumed by sourcing scripts
#
# config.default -- tracked defaults for the mi-lib workspace.
#
# Do NOT edit this file for local customization: create config.local
# (gitignored) next to it and assign only the variables you want to
# change. Everything is loaded through load_config.sh, which sources
# config.default first, then config.local (skipped when CI=true).
# Precedence: environment > config.local > config.default.
#
# List values (UPSTREAM_LIBS, CUSTOM_LIB_DEPS, APP_DIRS) are space
# separated and their entries must not contain whitespace; scalar
# values (e.g. PREFIX) must not contain spaces either, as they travel
# through make and sub-make command lines unquoted. CUSTOM_TEST_CMD is
# a full shell command line and may contain spaces.

### Library set ######################################################

# Libraries taken from the mi-lib organization (or your forks of them).
# The list must be closed under the inter-library dependencies encoded
# in the Makefile (e.g. roki-gl needs zeda zm zeo roki zx11 liw).
UPSTREAM_LIBS="zeda zm neuz dzco zeo roki liw zx11 roki-gl roki-fd"

# The single custom library managed alongside them ("" for none).
CUSTOM_LIB="pedi2"

# Its dependencies among UPSTREAM_LIBS (drives the build order).
CUSTOM_LIB_DEPS="zeda zm dzco zeo roki roki-gl"

# Command CI runs to test the custom library after a full build
# ("" to skip).
CUSTOM_TEST_CMD="make -C pedi2/test test"

### GitHub ###########################################################

# Organization that hosts the original libraries.
UPSTREAM_OWNER="mi-lib"

# Owner of the library forks. Empty = derive from this repository's
# origin URL. Set OWNER="$UPSTREAM_OWNER" to track the original
# repositories directly without forks (clone.sh then adds no upstream
# remotes, sync_upstream.sh pulls origin, fork.sh does nothing).
OWNER=""

# Owner of the custom library repository. Empty = derive from this
# repository's origin URL.
CUSTOM_LIB_OWNER=""

# Protocol for clone URLs: "ssh" or "https". Empty = derive from this
# repository's origin URL.
GIT_PROTOCOL=""

### Installation #####################################################

# Install prefix for headers, libraries, and tools.
PREFIX="$HOME/usr"

# Directory where gen_envrc.sh writes .envrc. Empty = dirname of
# PREFIX (e.g. PREFIX=<project>/.local gives <project>/.envrc).
ENVRC_DIR=""

### Compilation database / versions ##################################

# Out-of-tree application directories (absolute paths, space
# separated). Each must contain a makefile that builds the programs
# via the installed <lib>-config scripts.
APP_DIRS=""

# Compilation database path; the basename must be
# compile_commands.json (a compdb and clangd requirement). Empty =
# <this repository>/compile_commands.json. The .clangd configuration
# is generated next to it.
COMPILE_DB=""

# Version lock file; a relative path resolves against this
# repository. Convention for a local override: versions.local.lock.
VERSIONS_LOCK="versions.lock"
